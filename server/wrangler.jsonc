{
  "name": "mottainai",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/ws/*"] },
  "durable_objects": { "bindings": [ { "name": "ROOM", "class_name": "RoomDO" }, { "name": "TELEMETRY", "class_name": "TelemetryDO" }, { "name": "TEAMS", "class_name": "TeamsDO" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["RoomDO", "TelemetryDO"] }, { "tag": "v2", "new_sqlite_classes": ["TeamsDO"] } ],
  "observability": { "enabled": true },
  "env": {
    "v4": {
      "name": "mottainai-v4",
      "workers_dev": true,
      "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/ws/*"] },
      "durable_objects": { "bindings": [ { "name": "ROOM", "class_name": "RoomDO" }, { "name": "TELEMETRY", "class_name": "TelemetryDO" }, { "name": "TEAMS", "class_name": "TeamsDO" } ] },
      "migrations": [ { "tag": "v1", "new_sqlite_classes": ["RoomDO", "TelemetryDO"] }, { "tag": "v2", "new_sqlite_classes": ["TeamsDO"] } ]
    }
  }
}
